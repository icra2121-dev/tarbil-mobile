# Mobil uygulamada herkese açık olan değerler
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_INTEGRATION_API_URL=
# Anahtar gerektirmeyen resmî Parsel Sorgu kamu API'si; konum hassasiyeti düşürülmüştür
EXPO_PUBLIC_TKGM_PARCEL_API_URL=https://cbsapi.tkgm.gov.tr/megsiswebapi.v3.1/api

# Yalnızca sunucu/CI ortamında kullanılır; Expo uygulamasına konulmaz
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# TKGM tarafından protokol/abonelik sonrasında kuruma verilen yetkili OGC WFS
TKGM_WFS_URL=
TKGM_WFS_TYPENAME=
TKGM_WFS_VERSION=2.0.0
TKGM_WFS_OUTPUT_FORMAT=application/json
TKGM_WFS_SRS_NAME=EPSG:4326
TKGM_WFS_PAGE_SIZE=1000
TKGM_WFS_BBOX=
TKGM_WFS_CQL_FILTER=

# WFS yerine kurumdan teslim alınan EPSG:4326 GeoJSON da kullanılabilir
TKGM_GEOJSON_PATH=

# Kuruma verilen kimlik doğrulama yöntemlerinden yalnızca uygun olanı doldurun
TKGM_BEARER_TOKEN=
TKGM_API_KEY=
TKGM_API_KEY_HEADER=X-API-Key
TKGM_USERNAME=
TKGM_PASSWORD=

# Kurumsal şemadaki alan adları farklıysa eşleştirin
TKGM_ID_FIELD=
TKGM_CITY_FIELD=
TKGM_DISTRICT_FIELD=
TKGM_VILLAGE_FIELD=
TKGM_ADA_FIELD=
TKGM_PARCEL_FIELD=
TKGM_UPDATED_AT_FIELD=
TKGM_SOURCE_SRID=4326

# İlk deneme true kalmalı; doğrulamadan sonra false yapılarak yazma açılır
TKGM_IMPORT_DRY_RUN=true
TKGM_IMPORT_MAX_FEATURES=0
TKGM_REQUEST_TIMEOUT_MS=30000
TKGM_UPSERT_BATCH_SIZE=200
